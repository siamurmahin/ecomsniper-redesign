# The playbook keeps the URL the live site already publishes,
# /free-play-book — it is the link in the video descriptions and on the
# channel, so it has to keep working when this site replaces the old one.
#
# /free-playbook was this rebuild's own spelling for a while and may have been
# shared, so it redirects here rather than 404ing.
#
# Must come before the catch-all below: the first matching rule wins.
/free-playbook     /free-play-book     301!
/de/free-playbook  /de/free-play-book  301!

# The feature pages keep the readable slug. Their site publishes both
# spellings with different copy; the camelCase one 301s here rather than
# being deleted, so anything already linking or indexed against it survives.
# Decided 4 Sep — see docs/TODO.md.
/productHunterV6     /product-hunter     301!
/aiListerV6          /ai-powered-lister  301!
/competitorResearchV6  /competitor-research  301!
/priceMonitorV6        /price-monitor        301!
/course/dropshipMastery     /course/dropship-mastery     301!
/course/dropshipmastery     /course/dropship-mastery     301!
/de/productHunterV6  /de/product-hunter  301!
/de/aiListerV6       /de/ai-powered-lister  301!
/de/competitorResearchV6  /de/competitor-research  301!
/de/priceMonitorV6        /de/price-monitor        301!
/de/course/dropshipMastery  /de/course/dropship-mastery  301!
/de/course/dropshipmastery  /de/course/dropship-mastery  301!

# Their real affiliate URL. On their site /affiliate is a blank unmatched
# route and the contract lives at /affiliate/join; ours splits the offer
# from the contract, so their URL lands on the contract rather than the
# landing page a reader following an old link was not looking for.
/affiliate/join     /affiliate/terms     301!
/de/affiliate/join  /de/affiliate/terms  301!

# Anything else is a 404, and says so. Every route is prerendered, so a URL
# that reaches this rule does not exist; the SPA fallback this replaces
# answered it with the homepage under a 200. German first, so /de/anything
# gets the German 404. See the same rules, with the reasoning, in netlify.toml.
/de/*  /de/404/index.html  404
/*     /404/index.html     404
