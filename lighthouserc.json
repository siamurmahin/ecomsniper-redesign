{
  "ci": {
    "collect": {
      "staticDistDir": "build/client",
      "url": ["http://localhost/index.html"],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical", "is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],

        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 600 }],

        "resource-summary:script:size": ["error", { "maxNumericValue": 460800 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 133120 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 819200 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 168960 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }],

        "unused-javascript": "off",
        "uses-long-cache-ttl": "off",
        "legacy-javascript": "off"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
